# Copy to .env.local. Only NEXT_PUBLIC_* values are available in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site URL registered in Supabase Auth. Used for email confirmation/reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only upload limit in bytes (default 10485760 = 10 MB).
# MAX_UPLOAD_BYTES=10485760

# Server-only, used ONLY by the Supabase CLI / migration scripts.
# Never import into application code and never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
